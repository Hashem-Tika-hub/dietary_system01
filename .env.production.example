# انسخ هذا الملف إلى .env.production على الخادم فقط، ثم استبدل كل القيم.
# لا ترفع .env.production إلى GitHub.

# Docker image tag
APP_VERSION=v2.0.0

# DNS name for the second API. It must point to the server public IP before startup.
API_DOMAIN=api-v2.example.com

# PostgreSQL: use a long random password generated on the server.
POSTGRES_DB=dietary_v2
POSTGRES_USER=dietary_v2
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_POSTGRES_PASSWORD

# JWT signing: generate with `openssl rand -hex 32`.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET

# Optional food-data import key. Do not expose this value to Flutter.
USDA_API_KEY=REPLACE_WITH_USDA_KEY_IF_IMPORTS_ARE_NEEDED

# Comma-separated browser origins only. Native Flutter is not subject to CORS.
ALLOWED_ORIGINS=https://api-v2.example.com
